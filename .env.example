# Copy to .env on the server and adjust. Read by docker compose.

# Host address and port for the nginx front. Keep 127.0.0.1 and let the Pangolin tunnel publish it.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8088

# Folder with the context API JSON files (landcover, terrain, soil moisture, vegetation).
CONTEXT_DATA_DIR=/var/lib/arecibo/context-data

# FIRMS server settings, defaults as in the data-science repo.
FIRMS_MEM_LIMIT=6g
FIRMS_SEED_YEARS=2024,2025
FIRMS_EFFIS_FROM=2024
